{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Кинотека",
        "url": "index.html",
        "width": 1040,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "maximized": true,
        "decorations": false,
        "resizable": false,
        "backgroundColor": "#020203",
        "devtools": false,
        "shadow": true,
        "zoomHotkeysEnabled": false,
        "limitNavigationsToAppBoundDomains": true,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost https://query.wikidata.org https://commons.wikimedia.org https://upload.wikimedia.org",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "freezePrototype": true,
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      }
    }
  },
  "version": "1.2.0-preview.1"
}
